// Opcional: compilar o snes_arm_daemon junto com o AOSP (ver aosp/README.md).
// Copie a pasta braco/ para dentro da árvore (ex.: vendor/devtitans/braco).

cc_binary {
    name: "snes_arm_daemon",
    vendor: true,
    srcs: [
        "daemon/src/main.cpp",
        "daemon/src/snes_register.cpp",
        "daemon/src/forwarder.cpp",
        "daemon/src/serial_link.cpp",
        "daemon/src/evdev_reader.cpp",
        "firmware_esp32/SNES_ARM_ESP32/FrameProtocol.cpp",
    ],
    local_include_dirs: ["firmware_esp32/SNES_ARM_ESP32"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    cpp_std: "c++17",
    shared_libs: ["liblog"],
    init_rc: ["aosp/snes_arm_daemon.rc"],
}
